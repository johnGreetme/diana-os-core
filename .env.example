# D.I.A.N.A. OS - Configuration Profile
# WARNING: Do not package this file with real secrets in release builds!

# AI Core & LLM Gateway
OLLAMA_HOST="http://localhost:11434"
GEMINI_API_KEY="insert_optional_gemini_key_for_cloud_escalation"
TELEGRAM_BOT_TOKEN="insert_token_here"
TELEGRAM_CHAT_ID="insert_chat_id_here"

# Multimodal Parsers
FASTER_WHISPER_MODEL="base"
FASTER_WHISPER_COMPUTE="int8"

# Universal HAL Domain (scada | robotics | digital)
DIANA_DOMAIN="digital"
MODBUS_HOST="127.0.0.1"
MODBUS_PORT=502
Z3_TIMEOUT_MS=50

# Zero-Trust Cloud Bridge (Skill Forge LLM Escalation)
# Set to "true" ONLY if you explicitly authorize cloud LLM escalation.
# Default: disabled (air-gapped local-only execution).
ZERO_TRUST_CLOUD_BRIDGE="false"

# Sieve TOTP Gate Secret (RFC 6238 compliant)
HOMER_TOTP_SECRET="KYTIN_DEFAULT_SECRET_KEY_CHANGE_ME"

# Licensing & Hardware Locking
LICENSE_SERVER_URL="https://api.dianaprotocol.io/v1/activate"
